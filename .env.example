# Copy this file to ".env" (same folder as docker-compose.yml) and fill in what you have. Never commit .env.
# Email via Gmail: turn on 2-step verification, then create an "App password" at myaccount.google.com/apppasswords
EMAIL_HOST_USER=your.address@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
# SMS via Twilio (twilio.com): Account SID, Auth Token, and your Twilio phone number in +E.164 format
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
